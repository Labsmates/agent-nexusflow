    {
      "parameters": {
        "jsCode": "// Découper un texte long en segments de 4096 caractères maximum\nconst texte = $json[\"Contenu\"];\nconst maxLength = 4096;\nconst parties = [];\n\nfor (let i = 0; i < texte.length; i += maxLength) {\n  parties.push(texte.substring(i, i + maxLength));\n}\n\n// Retourner chaque segment pour traitement TTS\nreturn parties.map(p => ({ json: { segment: p } }));\n"
      },
