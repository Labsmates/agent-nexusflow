        "messages": {
          "values": [
            {
              "content": "==Tu es un assistant expert en résumé. Analyse le texte suivant et crée un résumé clair et structuré en français avec :\n1. Un titre accrocheur (<h2>)\n2. Les points clés (<h3> + <ul><li>)\n3. Les informations importantes (<p>)\n4. Une conclusion (<h3> + <p>)\nTexte à résumer :\n{{ $('When Executed by Another Workflow').item.json.query }}\nFormate UNIQUEMENT en HTML (<h2>,<h3>,<p>,<ul>,<li>,<strong>)\n"
            }
          ]
        },
        "options": {
          "maxTokens": 2000,
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        -240,
        -96
      ],
      "id": "d777f3d0-5d83-43f6-afa1-5cb86a2385bf",
      "name": "OpenAI Summarize",
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "OpenAi API"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "title-field",
              "name": "title",
              "value": "={{ $json.message.content.match(/<h2>(.*?)<\\/h2>/)?.[1] || 'Résumé Web' }}",
              "type": "string"
            },
            {
              "id": "summary-field",
              "name": "summary",
              "value": "={{ $json.message.content }}",
              "type": "string"
            },
            {
              "id": "url-field",
              "name": "source_url",
              "value": "={{ $('Extract Summary').item.json.url }}",
              "type": "string"
            },
            {
              "id": "date-field",
              "name": "date",
              "value": "={{ $now.toFormat('dd/MM/yyyy à HH:mm') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
