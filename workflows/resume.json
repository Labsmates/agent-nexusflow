      ],
      "id": "a0bdcf54-bb9e-4919-ac9a-4a8e84d76376",
      "name": "Préparer Données"
    },
    {
      "parameters": {
        "jsCode": "// Récupérer les données\nconst title = $input.item.json.title;\nconst summary = $input.item.json.summary;\nconst sourceUrl = $input.item.json.source_url;\nconst date = $input.item.json.date;\n\n// Créer le HTML complet\nconst htmlContent = `<!DOCTYPE html>\n<html lang=\"fr\">\n<head>\n<meta charset=\"UTF-8\">\n<title>${title}</title>\n<style>\nbody {\n  font-family: 'Segoe UI', Arial, sans-serif;\n  line-height: 1.7;\n  margin: 40px;\n  padding: 20px;\n  color: #2c3e50;\n  background: #fff;\n}\n.header {\n  text-align: center;\n  margin-bottom: 40px;\n  padding-bottom: 20px;\n  border-bottom: 2px solid #3498db;\n}\n.header h1 {\n  font-size: 28px;\n  margin-bottom: 10px;\n  color: #2c3e50;\n}\n.date, .url {\n  font-size: 12px;\n  color: #666;\n  margin: 5px 0;\n}\n.url {\n  word-break: break-all;\n}\nh2 {\n  font-size: 22px;\n  color: #2c3e50;\n  border-left: 4px solid #3498db;\n  padding-left: 10px;\n  margin-top: 30px;\n  margin-bottom: 15px;\n}\nh3 {\n  font-size: 18px;\n  color: #34495e;\n  margin-top: 25px;\n  margin-bottom: 10px;\n}\np {\n  margin-bottom: 15px;\n  text-align: justify;\n}\nul {\n  margin: 10px 0 20px 30px;\n}\nli {\n  margin-bottom: 8px;\n}\nstrong {\n  color: #2980b9;\n}\n</style>\n</head>\n<body>\n  <div class=\"header\">\n    <h1>📄 Résumé Web - ${title}</h1>\n    <p class=\"date\">📅 Généré le : ${date}</p>\n    <p class=\"url\">🔗 Source : ${sourceUrl}</p>\n  </div>\n\n  ${summary}\n</body>\n</html>`;\n\n// Convertir en buffer et retourner comme binaire\nconst buffer = Buffer.from(htmlContent, 'utf-8');\n\nreturn {\n  json: $input.item.json,\n  binary: {\n    data: {\n      data: buffer.toString('base64'),\n      mimeType: 'text/html',\n      fileName: 'index.html'\n    }\n  }\n};"
      },
