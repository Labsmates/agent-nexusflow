        352
      ],
      "id": "f7e8d9a1-2b3c-4d5e-af6g-7h8i9j0k1l2m",
      "name": "When Executed by Another Workflow",
      "notes": "Ce workflow démarre lorsqu'il est appelé par un autre workflow. Assurez-vous de passer les données nécessaires pour la génération d'image."
    },
    {
      "parameters": {
        "content": "## Configuration requise\n\n1. **OpenAI Credentials** : Configurez vos identifiants OpenAI dans le nœud OpenAI Chat Model\n2. **Telegram Credentials** : Ajoutez votre token de bot Telegram dans le nœud Telegram\n3. **Chat ID** : Modifiez le Chat ID dans le nœud Telegram pour votre destinataire\n\nLe workflow génère une image avec DALL-E 3 selon la demande reçue et l'envoie via Telegram.",
        "height": 408,
        "width": 478,
        "color": 5
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -112,
        256
      ],
      "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
      "name": "Configuration Guide"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.query }}",
        "options": {
          "systemMessage": "Tu es un assistant expert en génération d'images avec DALL-E 3. Ton rôle est d'interpréter les demandes de l'utilisateur et de créer des prompts détaillés et précis pour générer des images de haute qualité. Utilise toujours l'outil DALL-E 3 pour générer les images demandées."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        640,
        352
      ],
      "id": "b2c3d4e5-f6a7-8901-bcde-f23456789012",
      "name": "AI Agent DALL-E",
      "notes": "L'agent reçoit le prompt depuis le workflow appelant et génère une image avec DALL-E 3"
    },
    {
      "parameters": {
        "options": {
          "maxTokens": 2000,
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        560,
        544
      ],
      "id": "4851fbe9-94ee-409f-a4eb-87856904769c",
      "name": "OpenRouter Chat Model",
      "credentials": {
        "openRouterApi": {
          "id": "REPLACE_ME",
          "name": "OpenRouter API"
        }
      }
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "=8481398125",
        "binaryData": true,
        "additionalFields": {
          "caption": "Voici l'image que vous avez demandée !"
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1600,
        160
      ],
      "id": "b1d6e230-a228-4b95-b559-6deb6085db49",
      "name": "Send Image",
      "webhookId": "image-send-webhook",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "NexusFlow"
        }
      }
    },
    {
      "parameters": {
        "resource": "image",
        "prompt": "={{ $('AI Agent DALL-E').item.json.output || 'Génère une image par défaut' }}",
        "options": {
          "size": "1024x1024",
          "style": "=natural"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1216,
        352
      ],
      "id": "46aa14f3-ae9c-469e-b170-dc6d23649241",
      "name": "Generate Image",
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_ME",
          "name": "OpenAi API"
        }
      }
    },
    {
      "parameters": {
        "name": "=dalle3_{{ $now.format('yyyy-MM-dd_HH-mm-ss') }}.png",
        "driveId": {
          "__rl": true,
          "mode": "list",
