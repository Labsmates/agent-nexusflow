    {
      "parameters": {
        "jsCode": "const message = $json[\"message\"] || \"\";\nlet style = \"vivid\"; // par défaut\nif (message.toLowerCase().includes(\"natural\")) {\n  style = \"natural\";\n}\nreturn [{ json: { style } }];\n"
      },
