      ],
      "id": "df738d30-78d0-494c-9d7b-a1d4e2c44eb6",
      "name": "Récupérer Texte Amélioré"
    },
    {
      "parameters": {
        "jsCode": "// Récupérer les données du nœud précédent\nconst titre = $input.item.json.titre_document;\nconst date = $input.item.json.date_document;\nlet contenu = $input.item.json.texte_traite;\nconst dateGeneration = $input.item.json.date_generation;\n\n// Nettoyer le contenu des balises markdown si présentes\ncontenu = contenu.replace(/```html\\n?/g, '').replace(/```\\n?/g, '').trim();\n\n// Construire le HTML complet\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n    <meta charset=\"UTF-8\">\n    <title>${titre}</title>\n    <style>\n        body {\n            font-family: 'Segoe UI', Arial, sans-serif;\n            line-height: 1.8;\n            margin: 40px;\n            color: #333;\n            background-color: #fff;\n        }\n        h1 {\n            color: #2c3e50;\n            border-bottom: 3px solid #3498db;\n            padding-bottom: 15px;\n            margin-bottom: 10px;\n            font-size: 28px;\n        }\n        h2 {\n            color: #34495e;\n            margin-top: 30px;\n            margin-bottom: 15px;\n            font-size: 22px;\n            border-left: 4px solid #3498db;\n            padding-left: 15px;\n        }\n        h3 {\n            color: #7f8c8d;\n            margin-top: 20px;\n            margin-bottom: 10px;\n            font-size: 18px;\n        }\n        .header {\n            text-align: center;\n            margin-bottom: 40px;\n            padding-bottom: 20px;\n            border-bottom: 1px solid #ecf0f1;\n        }\n        .date {\n            color: #95a5a6;\n            font-style: italic;\n            font-size: 14px;\n        }\n        .content {\n            text-align: justify;\n        }\n        p {\n            margin-bottom: 15px;\n        }\n        strong {\n            color: #2c3e50;\n        }\n        em {\n            color: #7f8c8d;\n        }\n        ul, ol {\n            margin: 15px 0;\n            padding-left: 30px;\n        }\n        li {\n            margin-bottom: 8px;\n        }\n        .footer {\n            margin-top: 50px;\n            padding-top: 20px;\n            border-top: 1px solid #ecf0f1;\n            text-align: center;\n            color: #95a5a6;\n            font-size: 12px;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <h1>${titre}</h1>\n        <p class=\"date\">📅 Date : ${date}</p>\n    </div>\n    <div class=\"content\">\n        ${contenu}\n    </div>\n    <div class=\"footer\">\n        <p>Document généré automatiquement le ${dateGeneration}</p>\n    </div>\n</body>\n</html>`;\n\n// Convertir en Buffer pour les données binaires\nconst buffer = Buffer.from(html, 'utf-8');\n\nreturn { \n  json: {},\n  binary: {\n    data: {\n      data: buffer.toString('base64'),\n      mimeType: 'text/html',\n      fileName: 'index.html'\n    }\n  }\n};"
      },
